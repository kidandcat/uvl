    (39, #[4, 4, 0, 0, 0, 0, 0]),
    (40, #[2, 4, 8, 8, 8, 4, 2]),
    (41, #[8, 4, 2, 2, 2, 4, 8]),
    (42, #[0, 4, 21, 14, 21, 4, 0]),
    (43, #[0, 4, 4, 31, 4, 4, 0]),
    (44, #[0, 0, 0, 0, 12, 4, 8]),
    (45, #[0, 0, 0, 31, 0, 0, 0]),
    (46, #[0, 0, 0, 0, 0, 12, 12]),
    (47, #[0, 1, 2, 4, 8, 16, 0]),
    (48, #[14, 17, 19, 21, 25, 17, 14]),
    (49, #[4, 12, 4, 4, 4, 4, 14]),
    (50, #[14, 17, 1, 2, 4, 8, 31]),
    (51, #[31, 2, 4, 2, 1, 17, 14]),
