import UVL.Core.Geometry

/-!
# Built-in bitmap font

A dependency-free 5×7 font covering printable ASCII plus Spanish accented
letters. Each glyph is 7 rows of 5-bit masks (MSB = leftmost column). Glyphs are
rasterized with exact area coverage, so any (fractional) scale is anti-aliased.

The row masks are a static C table, so on bare metal they stay in flash
instead of the heap. `text` uses this font; TrueType and MSDF are separate paths.
-/

namespace UVL.Font

def cellW : Nat := 5
def cellH : Nat := 7
/-- Horizontal advance in cells (glyph width + 1 cell spacing). -/
def advance : Nat := 6

/-- Compiled code calls `uvl_glyph_row`. The interpreter never evaluates this. -/
@[extern "uvl_glyph_row"]
opaque glyphRowC (cp row : UInt32) : UInt32

/-- Interpreter lookup. The compiler replaces calls with `glyphRowC`, so this table
is not emitted into the C file and the masks stay in the static table. -/
@[implemented_by glyphRowC]
def glyphRowBits (cp row : UInt32) : UInt32 :=
  if row >= 7 then 0 else
    let table : Array (UInt32 × Array UInt32) := #[
    (32, #[0, 0, 0, 0, 0, 0, 0]),
    (33, #[4, 4, 4, 4, 4, 0, 4]),
    (34, #[10, 10, 0, 0, 0, 0, 0]),
    (35, #[10, 10, 31, 10, 31, 10, 10]),
    (36, #[4, 15, 20, 14, 5, 30, 4]),
    (37, #[24, 25, 2, 4, 8, 19, 3]),
