    match table.find? (·.1 == cp) with
    | some (_, g) => g[row.toNat]!
    | none => 0xFFFFFFFF

/-- The '?' mask, for a code point the table does not contain. -/
def fallbackRow (row : Nat) : Nat :=
  match row with
  | 0 => 14
  | 1 => 17
  | 2 => 1
  | 3 => 2
  | 4 => 4
  | 5 => 0
  | _ => 4

/-- Row `row` (0 .. 6) of `c`. Missing code points use `fallbackRow`. -/
def glyphRow (c : Char) (row : Nat) : Nat :=
  if row >= cellH then 0 else
    let bits := glyphRowBits c.toNat.toUInt32 row.toUInt32
    if bits == (0xFFFFFFFF : UInt32) then fallbackRow row else bits.toNat

/-- All seven rows of `c`. Prefer `glyphRow` when drawing: this allocates. -/
def glyph (c : Char) : Array Nat :=
  (Array.range cellH).map (glyphRow c)

def widthCells (s : String) : Nat :=
  let n := s.length
  if n == 0 then 0 else n * advance - 1

/-- Pixel size `(w, h)` of `s` rendered with cell scale `scale`. -/
def measure (s : String) (scale : Nat) : Nat × Nat :=
  (widthCells s * scale, cellH * scale)

end UVL.Font
