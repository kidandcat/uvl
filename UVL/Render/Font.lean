def cellW : Nat := 5
def cellH : Nat := 7
/-- Horizontal advance in cells (glyph width + 1 cell spacing). -/
def advance : Nat := 6

def fallback : Array Nat := #[14, 17, 1, 2, 4, 0, 4]

def glyph (c : Char) : Array Nat :=
  match glyphTable.find? (·.1 == c.toNat) with
  | some (_, g) => g
  | none => fallback

/-- Width in font cells of a string (no trailing spacing). -/
def widthCells (s : String) : Nat :=
  let n := s.length
  if n == 0 then 0 else n * advance - 1

/-- Pixel size `(w, h)` of `s` rendered with cell scale `scale`. -/
def measure (s : String) (scale : Nat) : Nat × Nat :=
  (widthCells s * scale, cellH * scale)

end UVL.Font
